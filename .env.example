# Copy to .env and fill in.

# Token of a Discord account that is a member of the official Deadlock server.
# Leave empty to run with demo data.
DISCORD_TOKEN=
DISCORD_GUILD_ID=1231286446472691825
POLL_SECONDS=90
# How many search pages (25 messages each) to backfill on the first run.
BACKFILL_PAGES=8

# Secret for POST /api/ingest (lets an external bridge/bot push messages). Empty = disabled.
INGEST_SECRET=

# Live collector
FAST_SECONDS=5
SEARCH_SECONDS=60

# Telegram notifications (filled by: .venv/bin/python -m backend.telegram_setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
